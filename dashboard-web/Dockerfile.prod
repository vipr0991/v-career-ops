FROM node:20-alpine as builder

LABEL maintainer="Career-Ops"
LABEL description="Career-Ops Dashboard - React frontend"
LABEL version="3.5.0"

WORKDIR /build

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --prefer-offline --no-audit

# Copy source code
COPY . .

# Build for production
RUN npm run build

# Runtime stage - serve with lightweight server
FROM node:20-alpine

WORKDIR /app

# Install serve package for production serving
RUN npm install -g serve

# Copy built app from builder
COPY --from=builder /build/dist ./dist

# Create .env with default values
RUN echo 'VITE_API_BASE=http://api:5000' > .env

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:5173', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Expose port
EXPOSE 5173

# Serve the app
CMD ["serve", "-s", "dist", "-l", "5173"]
