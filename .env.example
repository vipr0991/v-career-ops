# Career-Ops Environment Variables
# Copy to .env.local for local development — NEVER commit .env.local
#
# Sources per secret (see §4.5 of build instructions):
#   SUPABASE_*          → Vercel env vars / GitHub Actions secrets / Railway sealed vars
#   SERVICE_ROLE_KEY    → GitHub Actions secrets + Railway sealed (never browser-side)
#   PCLOUD_*            → Supabase Vault at runtime (never in .env)
#   ANTHROPIC_API_KEY   → GitHub Actions secrets (Tier-2 scoring)
#   GEMINI_API_KEY      → GitHub Actions secrets (Tier-1 triage)
#   VITE_API_BASE       → Vercel env vars (dashboard only)

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# PRODUCTION ONLY — rotate before committing to Railway
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ──────────────────────────────────────────────────────────────
# Tier-1 triage (Gemini Flash)
GEMINI_API_KEY=
# Tier-2 deep eval (Claude Sonnet 4.6 default)
ANTHROPIC_API_KEY=

# ── pCloud (stored in Supabase Vault at runtime — never in .env) ──────────────
# Set these ONLY in Supabase Vault, not here.
# PCLOUD_ACCESS_TOKEN=
# PCLOUD_API_HOST=api.pcloud.com   # or eapi.pcloud.com for EU

# ── Dashboard (Vite frontend) ─────────────────────────────────────────────────
# Local:      http://localhost:8080
# Docker:     http://api:8080
# Production: https://vcareer-ops-production.up.railway.app
VITE_API_BASE=http://localhost:8080

# ── Railway (API + PDF worker) ────────────────────────────────────────────────
PORT=8080

# ── GenSpark CLI (never stored in repo) ──────────────────────────────────────
# GSK_API_KEY=gsk_...
